# .env - إعدادات بوت مراقبة شواغر جامعة اليرموك

# توكن البوت الخاص بك من @BotFather على تيليجرام
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# الفاصل الزمني بين كل عملية فحص للشعب بالثواني (مثال: 3 ثواني للسرعة القصوى)
CHECK_INTERVAL_SECONDS=3


# تفعيل الوضع التجريبي لاختبار البوت وتجربة التنبيهات فوراً (True / False)
DEMO_MODE=True

# مسار قاعدة البيانات المحلية
DATABASE_PATH=yu_tracker.db

# رابط قاعدة البيانات السحابية الدائمة (اختياري - Render PostgreSQL أو Supabase)
DATABASE_URL=

# الحد الأقصى للمواد المراقبة لكل طالب
MAX_COURSES_PER_USER=10

# رابط نظام معلومات الطلبة أو الجدول الدراسي بجامعة اليرموك
YU_PORTAL_URL=https://sis.yu.edu.jo

# بيانات تسجيل الدخول لنظام SIS
STUDENT_ID=your_student_id
STUDENT_PASSWORD=your_sis_password

# إعدادات البريد الإلكتروني للتحقق التلقائي من رمز OTP
# يدعم إيميل الجامعة (@ses.yu.edu.jo) أو Outlook أو Gmail
EMAIL_USER=your_student_email@ses.yu.edu.jo
EMAIL_PASSWORD=your_email_password
EMAIL_HOST=outlook.office365.com
EMAIL_PORT=993

# معرف حساب التيليجرام للأدمن (User ID) لتوليد الأكواد
ADMIN_ID=7566322988

# يوزر حسابك على التيليجرام لكي يظهر زر تواصل مباشر للطلاب (مثال: my_user بدون @)
ADMIN_USERNAME=YOUR_TELEGRAM_USERNAME

# تفعيل نظام مفاتيح التفعيل والاشتراكات (True / False)
REQUIRE_ACTIVATION=True


